import java.util.Arrays;

public class AnaliseMeteorologica {

    // =========================
    // CONSTANTES
    // =========================
    static final int NUM_CIDADES = 5;
    static final double TEMP_MIN_LIMITE = -50;
    static final double TEMP_MAX_LIMITE = 60;

    static String[] cidades = {
            "São Paulo", "Rio de Janeiro", "Belo Horizonte",
            "Curitiba", "Salvador"
    };

    // Matriz 5x2 → [cidade][0=max, 1=min]
    static double[][] temperaturas = {
            {32, 22},
            {38, 25},
            {28, 18},
            {20, 10},
            {35, 26}
    };

    // Matriz 5x3 → [cidade][manha, tarde, noite]
    static int[][] umidades = {
            {80, 70, 75},
            {90, 85, 88},
            {60, 55, 65},
            {50, 45, 55},
            {85, 80, 78}
    };

    // =========================
    // MAIN
    // =========================
    public static void main(String[] args) {

        System.out.println("===== SISTEMA DE ANÁLISE METEOROLÓGICA =====\n");

        gerarRelatorioDetalhado();

        int cidadeAmplitude = identificarCidadeComMaiorAmplitudeTermica();
        System.out.println("\nCidade com maior amplitude térmica: "
                + cidades[cidadeAmplitude]);

        System.out.println("\nComparação exemplo:");
        System.out.println(compararCidades(0, 1));
    }

    // =========================
    // MÉTODOS OBRIGATÓRIOS
    // =========================

    public static double calcularMediaPonderadaTemperatura(double max, double min) {

        if (max < TEMP_MIN_LIMITE || max > TEMP_MAX_LIMITE ||
            min < TEMP_MIN_LIMITE || min > TEMP_MAX_LIMITE) {
            throw new IllegalArgumentException("Temperatura fora do intervalo permitido.");
        }

        return (max * 0.7) + (min * 0.3);
    }

    public static String classificarClima(double tempMedia, int umidadeMedia) {

        if (tempMedia > 30 && umidadeMedia > 75)
            return "MUITO QUENTE E ÚMIDO";
        else if (tempMedia >= 20 && tempMedia <= 25 &&
                umidadeMedia >= 50 && umidadeMedia <= 70)
            return "CONFORTAVEL";
        else if (tempMedia < 15 && umidadeMedia < 50)
            return "FRIO E SECO";
        else
            return "MODERADO";
    }

    public static int identificarCidadeComMaiorAmplitudeTermica() {

        double maiorAmplitude = 0;
        int indice = 0;

        for (int i = 0; i < NUM_CIDADES; i++) {
            double amplitude = temperaturas[i][0] - temperaturas[i][1];
            if (amplitude > maiorAmplitude) {
                maiorAmplitude = amplitude;
                indice = i;
            }
        }
        return indice;
    }

    public static double calcularIndiceCalor(double temp, int umidade) {

        double indice = temp + 0.5 * (umidade / 100.0) * (temp - 20);
        return Math.round(indice * 10.0) / 10.0;
    }

    public static int gerarAlertas(int cidadeIndex) {

        double max = temperaturas[cidadeIndex][0];
        double min = temperaturas[cidadeIndex][1];
        double variacao = max - min;

        int umidadeMedia = calcularMediaUmidade(cidadeIndex);

        if (max > 35 || umidadeMedia > 90)
            return 2; // vermelho
        else if ((max >= 30 && max <= 35 && umidadeMedia > 80)
                || variacao > 15)
            return 1; // amarelo
        else
            return 0; // verde
    }

    public static double[] calcularEstatisticasAvancadas() {

        double soma = 0;
        double maior = temperaturas[0][0];
        double menor = temperaturas[0][1];
        int totalValores = NUM_CIDADES * 2;

        for (int i = 0; i < NUM_CIDADES; i++) {
            for (int j = 0; j < 2; j++) {
                double valor = temperaturas[i][j];
                soma += valor;

                if (valor > maior) maior = valor;
                if (valor < menor) menor = valor;
            }
        }

        double media = soma / totalValores;

        double somaQuadrados = 0;
        for (int i = 0; i < NUM_CIDADES; i++) {
            for (int j = 0; j < 2; j++) {
                somaQuadrados += Math.pow(temperaturas[i][j] - media, 2);
            }
        }

        double desvioPadrao = Math.sqrt(somaQuadrados / totalValores);

        return new double[]{media, maior, menor, desvioPadrao};
    }

    public static String compararCidades(int c1, int c2) {

        double media1 = calcularMediaPonderadaTemperatura(
                temperaturas[c1][0], temperaturas[c1][1]);

        double media2 = calcularMediaPonderadaTemperatura(
                temperaturas[c2][0], temperaturas[c2][1]);

        int umidade1 = calcularMediaUmidade(c1);
        int umidade2 = calcularMediaUmidade(c2);

        String resultado = "";

        resultado += (media1 > media2)
                ? cidades[c1] + " é mais quente.\n"
                : cidades[c2] + " é mais quente.\n";

        resultado += (umidade1 > umidade2)
                ? cidades[c1] + " é mais úmida.\n"
                : cidades[c2] + " é mais úmida.\n";

        return resultado;
    }

    public static void gerarRelatorioDetalhado() {

        System.out.printf("%-20s %-10s %-10s %-10s %-15s %-10s\n",
                "Cidade", "TempMax", "TempMin", "Média", "Classificação", "Alerta");

        for (int i = 0; i < NUM_CIDADES; i++) {

            double mediaTemp = calcularMediaPonderadaTemperatura(
                    temperaturas[i][0], temperaturas[i][1]);

            int mediaUmidade = calcularMediaUmidade(i);

            String classificacao = classificarClima(mediaTemp, mediaUmidade);

            int alerta = gerarAlertas(i);

            String corAlerta;
            if (alerta == 2)
                corAlerta = "\u001B[31mVERMELHO\u001B[0m";
            else if (alerta == 1)
                corAlerta = "\u001B[33mAMARELO\u001B[0m";
            else
                corAlerta = "\u001B[32mVERDE\u001B[0m";

            System.out.printf("%-20s %-10.1f %-10.1f %-10.1f %-15s %-10s\n",
                    cidades[i],
                    temperaturas[i][0],
                    temperaturas[i][1],
                    mediaTemp,
                    classificacao,
                    corAlerta);
        }

        double[] estat = calcularEstatisticasAvancadas();

        System.out.println("\n===== ESTATÍSTICAS GERAIS =====");
        System.out.printf("Temperatura média geral: %.2f\n", estat[0]);
        System.out.printf("Maior temperatura: %.2f\n", estat[1]);
        System.out.printf("Menor temperatura: %.2f\n", estat[2]);
        System.out.printf("Desvio padrão: %.2f\n", estat[3]);
    }

    // =========================
    // MÉTODOS AUXILIARES
    // =========================

    public static int calcularMediaUmidade(int cidadeIndex) {
        int soma = 0;
        for (int i = 0; i < 3; i++)
            soma += umidades[cidadeIndex][i];

        return soma / 3;
    }
}